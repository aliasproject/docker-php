FROM ghcr.io/aliasproject/php:8.4-cli

LABEL maintainer="Michael Aguiar <mike@aliasproject.com>"

# Re-declared so this image can be given a UID independent of whatever the
# base was built with -- must match frankenphp/Dockerfile.wordpress's APP_UID
# for a given site, or the CLI container won't own what the web container
# writes (uploads, cache).
ARG APP_UID=1000

USER root

# Re-key appuser to APP_UID when it differs from the base image's UID. Safe
# to delete+recreate: nothing in the base is chown'd to appuser (shared dirs
# are chgrp'd to group 0 instead), so the only thing at the old UID is
# appuser's own (empty) home directory.
RUN if [ "${APP_UID}" != "$(id -u appuser)" ]; then \
        deluser appuser && \
        adduser -u ${APP_UID} -G root -s /sbin/nologin -D appuser; \
    fi

# Tier 2, mirroring frankenphp/Dockerfile.wordpress. Keep these two lists in
# sync: a WP-CLI run must be able to read what the web containers wrote.
#
# igbinary in particular is a correctness requirement, not parity for its own
# sake -- the redis-cache plugin can serialize with it, and a CLI without
# igbinary silently fails to deserialize the object cache.
RUN install-php-extensions \
    mysqli \
    gd \
    exif \
    redis \
    igbinary \
    imagick \
    soap

# ---------------------------------------------------------------------------
# WORDPRESS_VCS_CHECKOUT (opt-in, unset by default)
#
# WordPress skips background auto-updates (core, plugins, themes,
# translations) when it finds a .git, .svn, .hg or .bzr directory at or above
# the code it would update, so files deployed from a repository aren't
# rewritten underneath it. A deploy that keeps the repository outside the
# served folder loses that. WORDPRESS_VCS_CHECKOUT=1 restores it: the prepend
# file below seeds WordPress's automatic_updates_is_vcs_checkout filter with
# __return_true before WordPress loads, and WordPress (4.7+) turns pre-seeded
# $wp_filter entries into real hooks. Any other value, or unset, does nothing.
#
# auto_prepend_file runs before every PHP script in the image, WordPress or
# not, so the file only touches $GLOBALS['wp_filter'] and only when the
# variable is "1". WP-CLI runs (cron among them) can trigger auto-updates
# too, so the CLI image needs it as well as the web one. It lives outside
# /app and conf.d, root-owned and read-only to appuser. Every frankenphp
# Dockerfile.wordpress carries this same block; keep them in sync.
# ---------------------------------------------------------------------------
COPY <<'PHP' /usr/local/share/php-prepend/wordpress-vcs-checkout.php
<?php
// Prepended to every PHP script by Dockerfile.wordpress; see the comment there.
if (getenv('WORDPRESS_VCS_CHECKOUT') === '1') {
    $GLOBALS['wp_filter']['automatic_updates_is_vcs_checkout'][10][] = [
        'function' => '__return_true',
        'accepted_args' => 1,
    ];
}
PHP

# There is only one auto_prepend_file. Fail the build if the base ever sets
# one, rather than silently replacing it (chain to it from the file above if
# that happens), and fail if PHP doesn't pick up the new setting.
RUN php -r 'exit(ini_get("auto_prepend_file") === "" ? 0 : 1);' || \
        { echo "ERROR: base image already sets auto_prepend_file" >&2; exit 1; } && \
    echo 'auto_prepend_file = /usr/local/share/php-prepend/wordpress-vcs-checkout.php' \
        > "$PHP_INI_DIR/conf.d/wordpress-vcs-checkout.ini" && \
    test "$(php -r 'echo ini_get("auto_prepend_file");')" = /usr/local/share/php-prepend/wordpress-vcs-checkout.php || \
        { echo "ERROR: auto_prepend_file not picked up" >&2; exit 1; }

USER appuser
