#!/bin/ash
set -e

PHP_INI_DIR="${PHP_INI_DIR:-/usr/local/etc/php}"
CADDY_SITE_D=/config/caddy/site.d

# ---------------------------------------------------------------------------
# PHP configuration
# ---------------------------------------------------------------------------
{
    echo "memory_limit = ${PHP_MEMORY_LIMIT:-256M}"
    echo "max_execution_time = ${PHP_MAX_EXECUTION_TIME:-60}"
    echo "upload_max_filesize = ${PHP_UPLOAD_MAX_FILESIZE:-32M}"
    echo "post_max_size = ${PHP_POST_MAX_SIZE:-32M}"
    echo "max_input_vars = ${PHP_MAX_INPUT_VARS:-3000}"

    # Do not advertise the PHP version in response headers
    echo "expose_php = ${PHP_EXPOSE:-Off}"

    # Cuts stat() syscalls on include-heavy apps
    echo "realpath_cache_size = ${PHP_REALPATH_CACHE_SIZE:-4096K}"
    echo "realpath_cache_ttl = ${PHP_REALPATH_CACHE_TTL:-600}"

    echo "opcache.enable = ${PHP_OPCACHE_ENABLE:-1}"
    echo "opcache.memory_consumption = ${PHP_OPCACHE_MEMORY:-128}"
    echo "opcache.interned_strings_buffer = ${PHP_OPCACHE_INTERNED_STRINGS:-16}"
    echo "opcache.max_accelerated_files = ${PHP_OPCACHE_MAX_FILES:-10000}"
    echo "opcache.validate_timestamps = ${PHP_OPCACHE_VALIDATE_TIMESTAMPS:-0}"
    echo "opcache.revalidate_freq = ${PHP_OPCACHE_REVALIDATE_FREQ:-2}"
    # Fallbacks match the base Dockerfile's ENV defaults (off/0), not PHP's
    # own defaults -- JIT has a segfault history on web workloads and the
    # buffer is otherwise 128MB reserved per container for no benefit. If
    # these env vars are ever missing, fall back to the hardened values, not
    # the old insecure ones.
    echo "opcache.jit = ${PHP_OPCACHE_JIT:-off}"
    echo "opcache.jit_buffer_size = ${PHP_OPCACHE_JIT_BUFFER:-0}"

    # WordPress reads plugin/theme metadata out of docblocks, so comments must
    # survive compilation. Harmless elsewhere.
    echo "opcache.save_comments = 1"

    if [ -n "${PHP_DISABLE_FUNCTIONS}" ]; then
        echo "disable_functions = ${PHP_DISABLE_FUNCTIONS}"
    fi

    if [ -n "${PHP_OPEN_BASEDIR}" ]; then
        echo "open_basedir = ${PHP_OPEN_BASEDIR}"
    fi
} > "${PHP_INI_DIR}/conf.d/app.ini"

# ---------------------------------------------------------------------------
# Caddy hardening snippet (imported inside the site block, before php_server)
#
# Regenerated every boot. Always written, even when empty, because the
# Caddyfile imports this directory unconditionally.
# ---------------------------------------------------------------------------
mkdir -p "${CADDY_SITE_D}"

# Build a regex alternation from a space-separated extension list, escaping
# dots: "sql sql.gz bak" -> "sql|sql\.gz|bak". Used both for the global
# suffix denials and for hiding source inside no-exec paths below.
ext_alternation() {
    _pattern=""
    for _ext in $1; do
        _escaped=$(printf '%s' "$_ext" | sed 's/\./\\./g')
        if [ -z "$_pattern" ]; then
            _pattern="$_escaped"
        else
            _pattern="${_pattern}|${_escaped}"
        fi
    done
    printf '%s' "$_pattern"
}

{
    if [ "${CADDY_ACCESS_LOG:-on}" = "on" ]; then
        echo "log {"
        echo "  output file ${CADDY_ACCESS_LOG_PATH:-/data/caddy/access.log} {"
        echo "          roll_size ${CADDY_ACCESS_LOG_ROLL_SIZE:-100MiB}"
        echo "          roll_keep ${CADDY_ACCESS_LOG_ROLL_KEEP:-10}"
        echo "  }"
        echo "  format json"
        echo "}"
    fi

    # Paths that must never be served at all (secrets, VCS, dumps, backups).
    # Emitted as a `handle` so it shares a directive group with the no-exec
    # blocks below and is evaluated first; `respond` would otherwise sort
    # after them and lose to a no-exec prefix on overlapping paths
    # (e.g. /app/uploads/wpo/logs/*.log).
    if [ -n "${PHP_DENY_PATHS}" ]; then
        echo "@denied path ${PHP_DENY_PATHS}"
        echo "handle @denied {"
        echo "  respond 404"
        echo "}"
    fi

    # Suffix-based denials (backup/dump/log files) must match at any depth.
    # Caddy's path matcher "*" cannot cross "/" -- "/*.sql" matches "/dump.sql"
    # but NOT "/wp-content/uploads/dump.sql" -- and a backup dropped inside a
    # directory that's also in PHP_NO_EXEC_PATHS would otherwise be directly
    # downloadable via that directory's file_server. A suffix-anchored regex
    # has no such depth limit. PHP_DENY_EXTENSIONS is space-separated,
    # without leading dots (e.g. "sql sql.gz bak old log").
    if [ -n "${PHP_DENY_EXTENSIONS}" ]; then
        ext_pattern=$(ext_alternation "${PHP_DENY_EXTENSIONS}")
        echo "@denied_ext path_regexp \\.(${ext_pattern})\$"
        echo "handle @denied_ext {"
        echo "  respond 404"
        echo "}"
    fi

    # Paths the application can WRITE to must never EXECUTE. `handle` is
    # terminal and contains only file_server, so requests matching these
    # prefixes can never reach the PHP handler -- regardless of extension
    # casing, directory-index resolution, or split_path/path-info tricks.
    hide_pattern=$(ext_alternation "${PHP_NO_EXEC_HIDE_EXTENSIONS}")

    for p in ${PHP_NO_EXEC_PATHS}; do
            echo "handle ${p} {"
            # A no-exec path is a directory the app can WRITE to. Blocking
            # execution but still serving the bytes leaves any .php dropped
            # there downloadable as source: an attacker can confirm a webshell
            # survived, and any config a plugin generates under uploads/ leaks
            # its credentials. 404 rather than 403 so existence isn't
            # confirmed. Case-insensitive because file_server would otherwise
            # happily serve "SHELL.PHP".
            if [ -n "$hide_pattern" ]; then
                echo "  @src path_regexp (?i)\\.(${hide_pattern})\$"
                echo "  respond @src 404"
            fi
            echo "  file_server"
            echo "}"
        done
} > "${CADDY_SITE_D}/00-hardening.caddyfile"

# ---------------------------------------------------------------------------
# msmtp
# ---------------------------------------------------------------------------
cat > /etc/msmtprc <<EOF
defaults
tls ${MSMTP_RELAY_SERVER_TLS:-off}
tls_trust_file /etc/ssl/certs/ca-certificates.crt
logfile -

account default_account
host ${MSMTP_RELAY_SERVER_HOST:-mailhog}
port ${MSMTP_RELAY_SERVER_PORT:-1025}
auth ${MSMTP_RELAY_SERVER_AUTH:-off}
user ${MSMTP_RELAY_SERVER_USER}
password ${MSMTP_RELAY_SERVER_PASSWORD}
from ${MSMTP_RELAY_SERVER_FROM:-no-reply@localhost}

account default : default_account
EOF

# Ensure group write access remains intact after cat overwrites the file
chmod 660 /etc/msmtprc 2>/dev/null || true

exec /usr/local/bin/docker-php-entrypoint "$@"
