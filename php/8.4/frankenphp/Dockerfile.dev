FROM ghcr.io/aliasproject/php:8.4-frankenphp

LABEL maintainer="Michael Aguiar <mike@aliasproject.com>"

# Composer binary pulled directly from the official image — no network fetch at build time
COPY --from=composer:2 /usr/bin/composer /usr/local/bin/composer

# Switch to root for system package installation, then restore the non-root user
USER root

RUN apk add --no-cache git npm

# Pick up source edits without a container restart. The production default of
# validate_timestamps=0 means opcache never re-stats a file, so edited code
# keeps serving the old bytecode until the process dies.
ENV PHP_OPCACHE_VALIDATE_TIMESTAMPS=1 \
    PHP_OPCACHE_REVALIDATE_FREQ=0

# Dev tooling shells out constantly; leave the exec family alone here.
ENV PHP_DISABLE_FUNCTIONS=

USER appuser
