defaults
tls on
tls_trust_file /etc/ssl/certs/ca-certificates.crt
logfile -

account default
host ${MSMTP_RELAY_SERVER_HOST}
port ${MSMTP_RELAY_SERVER_PORT}
auth ${MSMTP_RELAY_SERVER_AUTH}
user ${MSMTP_RELAY_SERVER_USER}
password ${MSMTP_RELAY_SERVER_PASSWORD}
from ${MSMTP_RELAY_SERVER_FROM}

account default : default
