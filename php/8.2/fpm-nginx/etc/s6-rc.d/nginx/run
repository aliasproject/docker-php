#!/command/with-contenv ash

# Set Port for default
if [ $HTTP2 == "true" ]
then
    sed -i -r "s/80 default_server;/${PORT} default_server http2;/g" /etc/nginx/conf.d/default.conf
else
    sed -i -r "s/80 default_server;/${PORT} default_server;/g" /etc/nginx/conf.d/default.conf
fi

# Set Port for any additional vhosts
for filename in /etc/nginx/conf.d/*; do
    if [ "$filename" != "/etc/nginx/conf.d/default.conf" ]
    then
        if [ $HTTP2 == "true" ]
        then
            sed -i -r "s/80;/${PORT} http2;/g" $filename
        else
            sed -i -r "s/80;/${PORT};/g" $filename
        fi
    fi
done

# Start NGINX
nginx